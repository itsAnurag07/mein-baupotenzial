# Database Config
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mein_baupotenzial?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mein_baupotenzial"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="some-random-long-secret-key-32-chars-long"

# Admin Dashboard Access
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="secure-admin-password-123"

# File Upload Configuration
# If local upload is used, it saves to public/uploads directory.
# Set these for S3/Supabase storage option if using cloud.
# STORAGE_PROVIDER="supabase" or "s3" or "local" (default)
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION=""

# PayPal Configuration
# Sandbox Client ID. Replace with your actual sandbox/production client credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_CLIENT_SECRET=""
# Use "https://api-m.sandbox.paypal.com" for sandbox, "https://api-m.paypal.com" for live
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"

# Email Configuration (SMTP)
EMAIL_SERVER_HOST="smtp.mailtrap.io"
EMAIL_SERVER_PORT="2525"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="info@mein-baupotenzial.de"
INTERNAL_NOTIFICATION_EMAIL="info@mein-baupotenzial.de"
